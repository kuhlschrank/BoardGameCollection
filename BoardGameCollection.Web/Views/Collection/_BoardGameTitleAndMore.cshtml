@using System.Globalization
@model BoardGameCollection.Core.Models.BoardGame
@{ var game = Model; }

<div>
    <a target="_blank" href="http://boardgamegeek.com/boardgame/@game.Id" style="text-decoration: none">@Html.DisplayFor(modelItem => game.Title)</a>
</div>
                                
<div class="chips">
    <span class="chip rating" style="--r:@game.AverageRating.ToString("0.00", CultureInfo.InvariantCulture)" title="BGG-Rating">
        ★ @string.Format(CultureInfo.InvariantCulture, "{0:0.00}", game.AverageRating)
    </span>
                                    
    @if (game.AverageWeight > 0)
    {
        <span class="chip weight" style="--w:@game.AverageWeight.ToString("0.0", CultureInfo.InvariantCulture)" title="Weight (BGG)">
            ⚖️ @string.Format(CultureInfo.InvariantCulture, "{0:0.00}", game.AverageWeight)
        </span>
    }

    @if (game.MinAge > 0)
    {
        <span class="chip age" title="Minimum age (publisher)">
            @($"♙ {game.MinAge}+")
            @if (game.SuggestedAge > 0)
            {
                @($"/ {game.SuggestedAge}+")
            }
        </span>
    }
</div>